{
  "expo": {
    "name": "Financial Tracker",
    "slug": "financial-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.chengfai.financialtracker",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your financial tracker"
      }
    },
    "android": {
      "package": "com.chengfai.financialtracker",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font"
    ],
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "88afe3c5-a141-43c3-90c8-9faefac01967"
      }
    },
    "owner": "chengfai80"
  }
}
